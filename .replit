modules = ["web", "r-4.5", "python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["curl", "gnumake", "icu", "icu74", "openssl", "pandoc", "pkg-config", "zlib"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 63967
externalPort = 3001

[[ports]]
localPort = 64821
externalPort = 3000

[[ports]]
localPort = 65535
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python app.py"
waitForPort = 5000

[deployment]
deploymentTarget = "vm"
run = ["python", "app.py"]
